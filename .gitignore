# Local Claude config (settings, hooks)
.claude/

# Large data
data/
*.csv

# Local-only working artifacts (drafts, scratch, emails)
misc/

# paper/journal/ and paper/preprint/ track the built PDF only; the upload archives and source
# trees beside it are rebuilt by paper/make-submission.sh and paper/make-preprint.sh
paper/journal/*
!paper/journal/paper-odca-des.pdf
paper/preprint/*
!paper/preprint/paper-odca-des.pdf
